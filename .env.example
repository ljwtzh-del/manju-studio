# Run locally only until authentication is added. Do NOT expose this app directly to the internet.
APP_HOST=127.0.0.1
APP_PORT=8600
DATA_DIR=./data

# ComfyUI HTTP API (default ComfyUI server)
COMFYUI_URL=http://127.0.0.1:8188

# Agnes API is separate from the Pavo website subscription. Configure only if you have API access.
AGNES_API_BASE=https://apihub.agnes-ai.com
AGNES_API_KEY=
AGNES_VIDEO_MODEL=agnes-video-2.5

# Optional future adapter URL for a self-hosted TTS service; leave blank until an adapter is implemented.
TTS_API_BASE=

# Final render defaults
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=24
